import Mathlib.NumberTheory.Zsqrtd.GaussianInt
import Mathlib.RingTheory.Coprime.Basic

/-!
The source first chooses α in the ideal generated by 1+i with
N(a-αb) ≤ N(b), then incorrectly claims coprimality makes this strict.
Here a=b=-1 and α=1+i. Both Gaussian integers have coordinates of
opposite parity; α is an allowed multiplier and the preceding weak
bound holds, but equality N(a-αb)=N(b)=1 remains.

The previous certificate used α=i and N(a-αb)=2, which violated both
the multiplier restriction and the preceding weak bound. This file
uses Mathlib's GaussianInt, norm and IsCoprime directly.
-/
namespace MSE_605342_ans609345

def a : GaussianInt := -1
def b : GaussianInt := -1
def alpha : GaussianInt := ⟨1, 1⟩

theorem witness_coprime : IsCoprime a b := by
  exact ⟨0, -1, by decide⟩

/-- All inherited assumptions and the failure of strict descent. -/
theorem mse_605342__ans609345_refutation :
    IsCoprime a b ∧
    a.re % 2 ≠ a.im % 2 ∧ b.re % 2 ≠ b.im % 2 ∧
    alpha = (1 : GaussianInt) * ⟨1, 1⟩ ∧
    (a - alpha * b).norm ≤ b.norm ∧
    (a - alpha * b).norm = 1 ∧ b.norm = 1 ∧
    ¬ (a - alpha * b).norm < b.norm := by
  exact ⟨witness_coprime, by decide⟩

/-- Coprimality is compatible with divisibility by the unit b. -/
theorem divisibility_is_not_a_contradiction : IsCoprime a b ∧ b ∣ a := by
  exact ⟨witness_coprime, dvd_refl _⟩

end MSE_605342_ans609345
