  ],
  [
   26,
   "      | c = "
  ],
  [
   27,
   "}}"
  ],
  [
   28,
   "{{eqn | ll= \\leadsto"
  ],
  [
   29,
   "      | l = \\frac {\\d x} {\\d \\map F x}"
  ],
  [
   30,
   "      | r = x"
