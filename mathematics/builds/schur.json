   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.template_count",
    "statement": "for all A <= B <= N: R(tcol (2A) (2B), 2N) + h(N-B) + h(N-2A) + h(N-2B) = 2(B-A)(N-B+A) + h(N-A) + 2h(N-(A+B)), h(t) = t(t+1), truncated differences"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.region3",
    "statement": "for all A <= B <= N with 2A <= N <= 2B, N <= A+B: R + 5A^2 + 3B^2 + N^2 + N = 4AB + 4BN + A + B (region1, region2, region4 give the other three polynomial forms)"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.rational_count",
    "statement": "for all q >= 1, p <= r <= q with 2p <= q <= 2r, q <= p+r and ALL m: R(propCol p r q (2qm), 2qm) + (5p^2+3r^2+q^2) m^2 + q m = (4pr+4rq) m^2 + (p+r) m"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.rational_count_int",
    "statement": "same over Int: R = c2 m^2 + c1 m with c2 = 4pr+4rq-5p^2-3r^2-q^2, c1 = p+r-q"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.c2_stability",
    "statement": "121 c2 = 99 q^2 - 5U^2 + 4UV - 3V^2, U = 11p-4q, V = 11r-10q: c2/(2q^2) is the stability quadratic of the proposition"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.prop_count_even",
    "statement": "uniform exact count for the proposition colouring with thresholds p/q <= r/q at EVERY even n = 2N (thresholds rounded as the colouring rounds them)"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.propCol_eq_tcol",
    "statement": "for every n the cross-multiplied proposition colouring equals tcol with thresholds 2*ceil(floor(pn/q)/2), 2*ceil(floor(rn/q)/2)"
   },
   {
    "file": "SchurTemplateLink.lean",
    "name": "SchurTemplateLink.witness_count_again",
    "statement": "the certified count 99 m^2 + 3 m at (4,10,11) is the special case A=4m, B=10m, N=11m"
   },
   {
    "file": "SchurTemplateLimit.lean",
