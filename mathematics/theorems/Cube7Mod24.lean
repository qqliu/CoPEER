/-!
# Cube7Mod24 (generated by gen_certificate.py; core Lean, no Mathlib, no `sorry`, no `native_decide`)

Claim certified: let F = {0, 6, 18} as residues modulo 24 and, for any N divisible by 24,
A_N = { x < N : x mod 24 is not in F }. Then A_N contains no projective 7-cube: for EVERY list of
7 natural numbers some nonempty index subset has its Z_N sum outside A_N. Also |A_(24 k)| = 21 k.

Model (the same as in `../cube_kernel/BINDING.md`): an element of Z_N is a natural number and the group sum of
a family is its ordinary sum reduced modulo N; a multiset of size d is a list of length d; an index subset is
a Boolean mask, nonempty when some entry is true; the full index set is included; there is no base point.

Method: a memoised search over the sets of sub-sums reachable by sequences with no forbidden sub-sum.
The file lists, for each depth k < 7, every reachable set (`lv k`); the kernel checks that the lists are
closed under appending any residue (either a forbidden sub-sum appears, or the new set is in the next list)
and that no set survives to depth 7 (one `decide +kernel` per bucket, assembled into `chain_ok`). `sound` proves that such a closed
chain forces a forbidden sub-sum in every sequence of length 7. The lists are DATA produced by a Python
script; nothing about them is trusted: if a list were incomplete or wrong the closure check would fail, and
`sound` only uses the inclusion "every member of a listed set is a genuine sub-sum", which it proves.
Reachable sets per depth: depth 0: 1 sets; depth 1: 21 sets; depth 2: 187 sets; depth 3: 785 sets; depth 4: 1099 sets; depth 5: 382 sets; depth 6: 87 sets; depth 7: 0 sets.
-/
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
-- `if_pos`, `if_neg` and `if_true` are deprecated names in Lean 4.34 and current names in 4.30; both compile.
set_option linter.deprecated false

namespace Cube7Mod24

abbrev Buckets := List (List (Nat × List Nat))

def M : Nat := 24

/-- Forbidden residues. -/
def badRes (r : Nat) : Bool := r == 0 || r == 6 || r == 18

/-- A natural number whose residue modulo M is forbidden, i.e. lies outside A. -/
def bad (s : Nat) : Bool := badRes (s % M)

/-- Membership in A_N for a representative x (the bound x < N is carried separately). -/
def inA (x : Nat) : Bool := !bad x

/-- Sum of the entries selected by a Boolean mask. -/
def subSum : List Bool → List Nat → Nat
  | b :: m, x :: a => (if b then x else 0) + subSum m a
  | _, _ => 0

/-! ### Canonical form of a finite set of residues (sorted, duplicate-free) -/

def insU (x : Nat) : List Nat → List Nat
  | [] => [x]
  | y :: l => if x < y then x :: y :: l else if x = y then y :: l else y :: insU x l

def canon (l : List Nat) : List Nat := l.foldr insU []

theorem mem_insU {z x : Nat} : ∀ {l : List Nat}, z ∈ insU x l → z = x ∨ z ∈ l
  | [], h => by
    simp only [insU, List.mem_singleton] at h
    exact Or.inl h
  | y :: l, h => by
    simp only [insU] at h
    by_cases h1 : x < y
    · rw [if_pos h1] at h
      rcases List.mem_cons.mp h with h | h
      · exact Or.inl h
      · exact Or.inr h
    · rw [if_neg h1] at h
      by_cases h2 : x = y
      · rw [if_pos h2] at h
        exact Or.inr h
      · rw [if_neg h2] at h
        rcases List.mem_cons.mp h with h | h
        · exact Or.inr (h ▸ List.mem_cons_self ..)
        · rcases mem_insU h with h | h
          · exact Or.inl h
          · exact Or.inr (List.mem_cons_of_mem _ h)

theorem mem_canon {z : Nat} : ∀ {l : List Nat}, z ∈ canon l → z ∈ l
  | [], h => by simp [canon] at h
  | x :: l, h => by
    have h' : z ∈ insU x (canon l) := h
    rcases mem_insU h' with h' | h'
    · exact h' ▸ List.mem_cons_self ..
    · exact List.mem_cons_of_mem _ (mem_canon h')

/-! ### Bucketed lookup -/

def key (T : List Nat) : Nat := T.foldl (fun acc t => acc + 2 ^ t) 0

def bucket : Buckets → Nat → List (Nat × List Nat)
  | [], _ => []
  | b :: _, 0 => b
  | _ :: L, i + 1 => bucket L i

def lookup (L : Buckets) (T : List Nat) : Bool :=
  (bucket L (key T % 64)).any fun p => p.1 == key T && p.2 == T

/-- T is one of the listed sets. -/
def InB (L : Buckets) (T : List Nat) : Prop := ∃ b, b ∈ L ∧ ∃ p, p ∈ b ∧ p.2 = T

theorem mem_bucket {p : Nat × List Nat} : ∀ {L : Buckets} {i : Nat}, p ∈ bucket L i → ∃ b, b ∈ L ∧ p ∈ b
  | [], _, h => by simp [bucket] at h
  | b :: _, 0, h => ⟨b, List.mem_cons_self .., h⟩
  | _ :: L, i + 1, h => by
    obtain ⟨b, hb, hp⟩ := mem_bucket (L := L) (i := i) h
    exact ⟨b, List.mem_cons_of_mem _ hb, hp⟩

theorem lookup_sound {L : Buckets} {T : List Nat} (h : lookup L T = true) : InB L T := by
  obtain ⟨p, hp, hpT⟩ := List.any_eq_true.mp h
  obtain ⟨b, hb, hpb⟩ := mem_bucket hp
  have h2 : (p.2 == T) = true := (Bool.and_eq_true _ _ ▸ hpT : _ ∧ _).2
  exact ⟨b, hb, p, hpb, by simpa using h2⟩

/-! ### The closure check -/

def shift (T : List Nat) (a : Nat) : List Nat := T.map fun t => (t + a) % M

/-- Closure of one bucket: appending any residue to any listed set either creates a forbidden sub-sum or
lands in the next level. Checked bucket by bucket so that each kernel evaluation stays small. -/
def checkBucket (b : List (Nat × List Nat)) (L' : Buckets) : Bool :=
  b.all fun p => (List.range M).all fun a =>
    (shift p.2 a).any bad || lookup L' (canon (p.2 ++ shift p.2 a))

def closed (L L' : Buckets) : Bool := L.all fun b => checkBucket b L'

def chainOK : List Buckets → Bool
  | [] => true
  | [L] => L.all fun b => b.isEmpty
  | L :: L' :: rest => closed L L' && chainOK (L' :: rest)

theorem closed_step {L L' : Buckets} (h : closed L L' = true) {T : List Nat} (hT : InB L T)
    {a : Nat} (ha : a < M) :
    (shift T a).any bad = true ∨ InB L' (canon (T ++ shift T a)) := by
  obtain ⟨b, hb, p, hp, rfl⟩ := hT
  have h1 : checkBucket b L' = true := List.all_eq_true.mp h b hb
  have h2 := List.all_eq_true.mp h1 p hp
  have h3 := List.all_eq_true.mp h2 a (List.mem_range.mpr ha)
  rcases Bool.or_eq_true _ _ ▸ h3 with h4 | h4
  · exact Or.inl h4
  · exact Or.inr (lookup_sound h4)

/-! ### Soundness -/

/-- Every listed residue is a genuine sub-sum (possibly the empty one) of the prefix p, modulo M. -/
def Real (p : List Nat) (T : List Nat) : Prop :=
  ∀ t, t ∈ T → ∃ m : List Bool, m.length = p.length ∧ subSum m p % M = t

/-- Some nonempty index subset has a forbidden sum. -/
def HasBad (l : List Nat) : Prop :=
  ∃ m : List Bool, m.length = l.length ∧ m.any id = true ∧ bad (subSum m l) = true

theorem bad_congr {s t : Nat} (h : s % M = t % M) : bad s = bad t := by
  simp only [bad, h]

theorem hasBad_cons {l : List Nat} (x : Nat) (h : HasBad l) : HasBad (x :: l) := by
  obtain ⟨m, hm, hne, hb⟩ := h
  exact ⟨false :: m, by simp [hm], by simpa using hne, by simpa [subSum] using hb⟩

theorem hasBad_append {p : List Nat} (h : HasBad p) : ∀ q : List Nat, HasBad (q ++ p)
  | [] => h
  | x :: q => hasBad_cons x (hasBad_append h q)

theorem real_step {p T : List Nat} (hR : Real p T) (x : Nat) :
    Real (x :: p) (canon (T ++ shift T x)) := by
  intro z hz
  rcases List.mem_append.mp (mem_canon hz) with hz | hz
  · obtain ⟨m, hm, hs⟩ := hR z hz
    exact ⟨false :: m, by simp [hm], by simpa [subSum] using hs⟩
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hz
    obtain ⟨m, hm, hs⟩ := hR t ht
    refine ⟨true :: m, by simp [hm], ?_⟩
    simp only [subSum, if_true]
    rw [← hs, Nat.mod_add_mod, Nat.add_comm]

theorem bad_step {p T : List Nat} (hR : Real p T) (x : Nat) (h : (shift T x).any bad = true) :
    HasBad (x :: p) := by
  obtain ⟨z, hz, hb⟩ := List.any_eq_true.mp h
  obtain ⟨t, ht, rfl⟩ := List.mem_map.mp hz
  obtain ⟨m, hm, hs⟩ := hR t ht
  refine ⟨true :: m, by simp [hm], by simp, ?_⟩
  have e : (x + subSum m p) % M = ((t + x) % M) % M := by
    rw [← hs, Nat.mod_add_mod, Nat.mod_mod, Nat.add_comm]
  simp only [subSum, if_true]
  rw [bad_congr e]
  exact hb

theorem sound : ∀ (levels : List Buckets) (L : Buckets) (p T : List Nat),
    chainOK (L :: levels) = true → InB L T → Real p T →
    ∀ e : List Nat, e.length = levels.length → (∀ x, x ∈ e → x < M) → HasBad (e.reverse ++ p)
  | [], L, p, T, hc, hT, _, e, _, _ => by
    obtain ⟨b, hb, q, hq, _⟩ := hT
    have h1 := List.all_eq_true.mp hc b hb
    have : b = [] := List.isEmpty_iff.mp h1
    subst this
    exact absurd hq (List.not_mem_nil)
  | L' :: rest, L, p, T, hc, hT, hR, e, he, hlt => by
    cases e with
    | nil => simp at he
    | cons x e' =>
      simp only [chainOK, Bool.and_eq_true] at hc
      have hx : x < M := hlt x (List.mem_cons_self ..)
      have hrev : (x :: e').reverse ++ p = e'.reverse ++ (x :: p) := by
        simp [List.reverse_cons, List.append_assoc]
      rw [hrev]
      rcases closed_step hc.1 hT hx with h | h
      · exact hasBad_append (bad_step hR x h) _
      · exact sound rest L' (x :: p) _ hc.2 h (real_step hR x) e' (by simpa using he)
          (fun y hy => hlt y (List.mem_cons_of_mem _ hy))

