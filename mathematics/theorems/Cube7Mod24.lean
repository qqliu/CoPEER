/-- Every list of 7 residues below M has a nonempty sub-sum with a forbidden residue. -/
theorem core (l : List Nat) (hlen : l.length = 7) (hlt : ∀ x, x ∈ l → x < M) : HasBad l := by
  have hR : Real [] [0] := by
    intro t ht
    have : t = 0 := by simpa using ht
    exact ⟨[], rfl, by simp [subSum, this]⟩
  have hIn : InB lv0 [0] := ⟨lv0_b0, List.mem_cons_self .., (1, [0]), List.mem_cons_self .., rfl⟩
  have h := sound [lv1, lv2, lv3, lv4, lv5, lv6, lvEnd] lv0 [] [0] chain_ok hIn hR l.reverse
    (by simp [hlen]) (fun x hx => hlt x (List.mem_reverse.mp hx))
  simpa using h

theorem subSum_mod : ∀ (m : List Bool) (a : List Nat),
    subSum m (a.map (· % M)) % M = subSum m a % M
  | [], a => by cases a <;> simp [subSum]
  | _ :: _, [] => by simp [subSum]
  | b :: m, x :: a => by
    have ih := subSum_mod m a
    cases b
    · simpa [subSum] using ih
    · simp only [subSum, List.map_cons, if_true]
      rw [Nat.add_mod, ih, ← Nat.add_mod, Nat.mod_add_mod]

/-- A_N contains no projective 7-cube, for every N divisible by M and every 7 naturals. -/
theorem cube_free (N : Nat) (hN : M ∣ N) (a : List Nat) (hlen : a.length = 7) :
    ∃ m : List Bool, m.length = 7 ∧ m.any id = true ∧ inA (subSum m a % N) = false := by
  obtain ⟨m, hm, hne, hb⟩ := core (a.map (· % M)) (by simpa using hlen) (by
    intro x hx
    obtain ⟨y, _, rfl⟩ := List.mem_map.mp hx
    exact Nat.mod_lt _ (by decide))
  refine ⟨m, by simpa [hlen] using hm, hne, ?_⟩
  have h1 : (subSum m a % N) % M = subSum m a % M := Nat.mod_mod_of_dvd _ hN
  have h2 : bad (subSum m a % N) = bad (subSum m (a.map (· % M))) :=
    bad_congr (h1.trans (subSum_mod m a).symm)
  simp [inA, h2, hb]

/-! ### Cardinality: |A_(M k)| = 21 k -/

def cntFrom (n : Nat) : Nat → Nat
  | 0 => 0
  | j + 1 => cntFrom n j + (if inA (n + j) then 1 else 0)

/-- Number of elements of A among 0, ..., n - 1. -/
def cnt (n : Nat) : Nat := cntFrom 0 n

theorem cntFrom_add (n : Nat) : ∀ j : Nat, cntFrom 0 (n + j) = cntFrom 0 n + cntFrom n j
  | 0 => rfl
  | j + 1 => by
    have ih := cntFrom_add n j
    show cntFrom 0 (n + j) + (if inA (0 + (n + j)) then 1 else 0) =
      cntFrom 0 n + (cntFrom n j + (if inA (n + j) then 1 else 0))
    rw [ih, Nat.zero_add, Nat.add_assoc]

theorem cntFrom_shift (k : Nat) : ∀ j : Nat, cntFrom (M * k) j = cntFrom 0 j
  | 0 => rfl
  | j + 1 => by
    have ih := cntFrom_shift k j
    have e : inA (M * k + j) = inA (0 + j) := by
      simp only [inA, bad, Nat.mul_add_mod, Nat.zero_add]
    show cntFrom (M * k) j + (if inA (M * k + j) then 1 else 0) =
      cntFrom 0 j + (if inA (0 + j) then 1 else 0)
    rw [ih, e]

theorem cnt_block : cnt M = 21 := by decide +kernel

theorem card_A : ∀ k : Nat, cnt (M * k) = 21 * k
  | 0 => rfl
  | k + 1 => by
    have ih := card_A k
    have e : M * (k + 1) = M * k + M := Nat.mul_succ M k
    show cntFrom 0 (M * (k + 1)) = 21 * (k + 1)
    rw [e, cntFrom_add, cntFrom_shift]
    have h1 : cntFrom 0 (M * k) = 21 * k := ih
    have h2 : cntFrom 0 M = 21 := cnt_block
    rw [h1, h2, Nat.mul_succ]

/-! ### The source's Conjecture 4, stated generally, and its negation -/

/-- Number of x < n with A x. -/
def card (A : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => card A n + (if A n then 1 else 0)

/-- Definition 2 of the source: A (read on representatives below N) contains no projective d-cube of Z_N. -/
def CubeFree (d N : Nat) (A : Nat → Bool) : Prop :=
  ∀ a : List Nat, a.length = d → (∀ x, x ∈ a → x < N) →
    ∃ m : List Bool, m.length = d ∧ m.any id = true ∧ A (subSum m a % N) = false

/-- Conjecture 4 of Meng (EJC 2026): a d-cube-free subset of Z_N with d | N has at most ((d-1)/d) N elements. -/
def Conjecture4 : Prop :=
  ∀ d N : Nat, 0 < d → 0 < N → d ∣ N →
    ∀ A : Nat → Bool, CubeFree d N A → d * card A N ≤ (d - 1) * N

theorem card_eq_cnt : ∀ n, card inA n = cnt n
  | 0 => rfl
  | n + 1 => by
    show card inA n + (if inA n then 1 else 0) = cntFrom 0 n + (if inA (0 + n) then 1 else 0)
    rw [card_eq_cnt n, Nat.zero_add]; rfl

/-- For every k >= 1, at N = 168 k: 7 divides N, A_N contains no projective 7-cube, and
|A_N| = 147 k exceeds ((7 - 1)/7) N. -/
theorem family (k : Nat) (hk : 0 < k) :
    7 ∣ 168 * k ∧ CubeFree 7 (168 * k) inA ∧
    ¬ (7 * card inA (168 * k) ≤ (7 - 1) * (168 * k)) := by
  have hM : M ∣ 168 * k := ⟨7 * k, by simp only [M]; omega⟩
  have hc : cnt (168 * k) = 21 * (7 * k) := by
    have := card_A (7 * k)
    rwa [show M * (7 * k) = 168 * k by simp only [M]; omega] at this
  refine ⟨⟨24 * k, by omega⟩, fun a hlen _ => cube_free _ hM a hlen, ?_⟩
  rw [card_eq_cnt, hc]; omega

theorem not_conjecture4 : ¬ Conjecture4 := by
  intro h
  obtain ⟨hd, hfree, hbig⟩ := family 1 (by decide)
  exact hbig (h 7 (168 * 1) (by decide) (by decide) hd inA hfree)

